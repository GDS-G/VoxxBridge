# Safe local defaults for a developer-alpha gateway.
VOXBRIDGE_TRANSPORT=streamable-http
VOXBRIDGE_HOST=127.0.0.1
VOXBRIDGE_PORT=8000
VOXBRIDGE_LOG_LEVEL=INFO
VOXBRIDGE_ALLOW_REMOTE_BIND=false
VOXBRIDGE_MAX_TEXT_CHARS=3000
VOXBRIDGE_MAX_AUDIO_BYTES=20971520
VOXBRIDGE_MAX_CONCURRENT_GENERATIONS=2
VOXBRIDGE_AUDIO_DOWNLOAD_TTL_SECONDS=900
VOXBRIDGE_AUDIO_DOWNLOAD_MAX_ITEMS=32
VOXBRIDGE_AUDIO_DOWNLOAD_MAX_BYTES=67108864
VOXBRIDGE_REQUEST_TIMEOUT_SECONDS=60
VOXBRIDGE_ALLOWED_HOSTS='["127.0.0.1:*","localhost:*","[::1]:*"]'
VOXBRIDGE_ALLOWED_ORIGINS='["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]'

# Hosted private-alpha only. Use a dedicated runtime key, not an admin key.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Provider credentials. Configure only providers you intend to use.
ELEVENLABS_API_KEY=
HUME_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
RESEMBLE_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Google Cloud TTS: file-based ADC is detected from GOOGLE_APPLICATION_CREDENTIALS.
# Set GOOGLE_CLOUD_TTS_ENABLED=true for metadata/workload-identity ADC.
# GOOGLE_CLOUD_PROJECT optionally overrides the quota project used for requests.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_TTS_ENABLED=false

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
